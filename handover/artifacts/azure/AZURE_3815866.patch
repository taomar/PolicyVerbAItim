index 0000000000000000000000000000000000000000..7aea70367ecba15a8a2650739c65f9837bd378c1
--- /dev/null
+++ b/tests/unit/test_manage_local_auth.py
@@ -0,0 +1,104 @@
+"""Pure lifecycle transformations never contact Azure or expose credential values."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import secrets
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).parents[2] / "infra" / "scripts" / "manage_local_auth.py"
+SPEC = importlib.util.spec_from_file_location("manage_local_auth", SCRIPT)
+assert SPEC and SPEC.loader
+manage = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(manage)
+
+
+def _bundle():
+    return manage.new_bundle(
+        admin_username="synthetic-operator",
+        password=secrets.token_urlsafe(24),
+        token_ttl_minutes=30,
+    )
+
+
+def test_bootstrap_contains_one_enabled_admin_and_no_plaintext_password():
+    password = secrets.token_urlsafe(24)
+    bundle = manage.new_bundle(
+        admin_username="synthetic-operator",
+        password=password,
+        token_ttl_minutes=30,
+    )
+    assert bundle["accounts"][0]["role"] == "admin"
+    assert bundle["accounts"][0]["enabled"] is True
+    assert password not in str(bundle)
+
+
+def test_operator_tool_refuses_a_password_below_the_production_floor():
+    with pytest.raises(ValueError, match="at least 15"):
+        manage.validate_password("too-short")
+    candidate = secrets.token_urlsafe(24)
+    assert manage.validate_password(candidate) == candidate
+
+
+def test_password_and_role_changes_increment_token_version():
+    bundle = _bundle()
+    initial = bundle["accounts"][0]["token_version"]
+    manage.rotate_password(
+        bundle,
+        username="synthetic-operator",
+        password=secrets.token_urlsafe(24),
+    )
+    assert bundle["accounts"][0]["token_version"] == initial + 1
+    manage.add_account(
+        bundle,
+        username="synthetic-author",
+        password=secrets.token_urlsafe(24),
+        role="viewer",
+    )
+    manage.set_role(bundle, username="synthetic-author", role="policy_author")
+    assert bundle["accounts"][1]["token_version"] == 2
+    assert bundle["accounts"][1]["role"] == "policy_author"
+
+
+def test_last_enabled_admin_cannot_be_disabled_or_demoted():
+    with pytest.raises(Exception, match="enabled administrator"):
+        manage.disable_account(_bundle(), username="synthetic-operator")
+    with pytest.raises(Exception, match="enabled administrator"):
+        manage.set_role(_bundle(), username="synthetic-operator", role="viewer")
+
+
+def test_normal_signing_rotation_keeps_one_previous_key_for_full_token_lifetime():
+    bundle = _bundle()
+    old_kid = bundle["current_kid"]
+    now = datetime.now(tz=timezone.utc)
+    manage.rotate_signing_key(bundle, now=now, max_stale_seconds=300)
+    assert len(bundle["signing_keys"]) == 2
+    previous = next(key for key in bundle["signing_keys"] if key["kid"] == old_kid)
+    verify_until = datetime.fromisoformat(previous["verify_until"])
+    assert verify_until >= (
+        now + timedelta(minutes=bundle["token_ttl_minutes"]) + timedelta(seconds=300)
+    )
+
+    with pytest.raises(ValueError, match="mandatory verification window"):
+        manage.rotate_signing_key(
+            bundle,
+            now=now + timedelta(minutes=1),
+            max_stale_seconds=300,
+        )
+
+
+def test_emergency_revoke_and_rollback_use_fresh_generation_and_key_ring():
+    original = _bundle()
+    old_generation = original["generation"]
+    old_kid = original["current_kid"]
+    revoked = manage.emergency_revoke(copy.deepcopy(original))
+    assert revoked["generation"] != old_generation
+    assert revoked["current_kid"] != old_kid
+    assert len(revoked["signing_keys"]) == 1
+
+    rolled_back = manage.rollback_as_new_generation(copy.deepcopy(original))
+    assert rolled_back["generation"] not in {old_generation, revoked["generation"]}
+    assert rolled_back["current_kid"] not in {old_kid, revoked["current_kid"]}
