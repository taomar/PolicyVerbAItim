+        entry = _mapping(raw_key, f"signing_keys[{index}]")
+        _exact_keys(entry, {"kid", "private_key_pem", "verify_until"}, f"signing_keys[{index}]")
+        kid = _nonempty_string(entry["kid"], "kid", max_length=128)
+        if kid in seen_kids:
+            raise LocalAuthConfigurationError("Signing key IDs must be unique")
+        seen_kids.add(kid)
+        verify_until = (
+            None
+            if entry["verify_until"] is None
+            else _instant(entry["verify_until"], "verify_until")
+        )
+        if kid == current_kid and verify_until is not None:
+            raise LocalAuthConfigurationError("The current signing key cannot have verify_until")
+        if kid != current_kid and verify_until is None:
+            raise LocalAuthConfigurationError("A previous signing key requires verify_until")
+        signing_keys.append(
+            LocalSigningKey(
+                kid=kid,
+                private_key=_private_key(entry["private_key_pem"], "private_key_pem"),
+                verify_until=verify_until,
