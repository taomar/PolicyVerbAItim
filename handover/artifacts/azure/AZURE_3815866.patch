+
+def _positive_int(value: Any, label: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
+        raise LocalAuthConfigurationError(f"{label} must be a positive integer")
+    return value
+
+
+def _instant(value: Any, label: str) -> float:
+    text = _nonempty_string(value, label, max_length=64)
+    try:
+        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
+    except ValueError as exc:
+        raise LocalAuthConfigurationError(f"{label} must be an ISO-8601 instant") from exc
+    if parsed.tzinfo is None:
+        raise LocalAuthConfigurationError(f"{label} must include a timezone")
+    return parsed.timestamp()
+
+
+def _private_key(value: Any, label: str) -> rsa.RSAPrivateKey:
+    pem = _nonempty_string(value, label, max_length=8_192)
+    try:
+        key = serialization.load_pem_private_key(pem.encode("utf-8"), password=None)
+    except (TypeError, ValueError) as exc:
+        raise LocalAuthConfigurationError(f"{label} is not a valid private key") from exc
+    if not isinstance(key, rsa.RSAPrivateKey) or key.key_size < 2048:
+        raise LocalAuthConfigurationError(f"{label} must be an RSA key of at least 2048 bits")
+    return key
