+    generation = _nonempty_string(document["generation"], "generation", max_length=128)
+    current_kid = _nonempty_string(document["current_kid"], "current_kid", max_length=128)
+    token_ttl_minutes = _positive_int(document["token_ttl_minutes"], "token_ttl_minutes")
+    if not MIN_TOKEN_TTL_MINUTES <= token_ttl_minutes <= max_token_ttl_minutes:
+        raise LocalAuthConfigurationError("token_ttl_minutes is outside the configured bounds")
