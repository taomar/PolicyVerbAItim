+        raise LocalAuthConfigurationError("accounts must contain between 1 and 100 entries")
+
+    accounts: list[LocalAccount] = []
+    seen_ids: set[str] = set()
+    seen_usernames: set[str] = set()
+    for index, raw_account in enumerate(raw_accounts):
+        entry = _mapping(raw_account, f"accounts[{index}]")
+        _exact_keys(
+            entry,
+            {"id", "username", "password_hash", "role", "enabled", "token_version"},
+            f"accounts[{index}]",
+        )
+        account_id = _nonempty_string(entry["id"], "account id", max_length=128)
+        username = _nonempty_string(entry["username"], "username", max_length=128)
+        normalized_username = normalize_username(username)
+        if not normalized_username:
+            raise LocalAuthConfigurationError("username normalizes to an empty value")
+        if account_id in seen_ids or normalized_username in seen_usernames:
+            raise LocalAuthConfigurationError("Account IDs and normalized usernames must be unique")
+        seen_ids.add(account_id)
+        seen_usernames.add(normalized_username)
