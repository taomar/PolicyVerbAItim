+class _Clock:
+    def __init__(self, value: float = 1_000.0):
+        self.value = value
+
+    def __call__(self) -> float:
+        return self.value
+
+    def advance(self, seconds: float) -> None:
+        self.value += seconds
+
+
+class _MemorySource:
+    def __init__(self, value: str, version: str = "1"):
+        self.value = value
+        self.version = version
+        self.failure: Exception | None = None
+
+    def load(self) -> LoadedBundle:
+        if self.failure is not None:
+            raise self.failure
+        return LoadedBundle(value=self.value, version=self.version)
+
+    def close(self) -> None:
+        return None
+
+
+def _private_key_pem(key: rsa.RSAPrivateKey) -> str:
+    return key.private_bytes(
+        encoding=serialization.Encoding.PEM,
+        format=serialization.PrivateFormat.PKCS8,
+        encryption_algorithm=serialization.NoEncryption(),
+    ).decode("ascii")
+
+
+def _bundle(
+    *,
+    password: str,
+    generation: str = "generation-1",
+    token_version: int = 1,
+    enabled: bool = True,
+    role: str = "admin",
+    current_key: rsa.RSAPrivateKey | None = None,
+    current_kid: str = "current",
+    previous: tuple[str, rsa.RSAPrivateKey, float] | None = None,
+    token_ttl_minutes: int = 30,
+) -> str:
+    key = current_key or rsa.generate_private_key(public_exponent=65537, key_size=2048)
+    signing_keys = [
+        {
+            "kid": current_kid,
+            "private_key_pem": _private_key_pem(key),
+            "verify_until": None,
+        }
+    ]
+    if previous is not None:
+        previous_kid, previous_key, verify_until = previous
+        signing_keys.append(
+            {
+                "kid": previous_kid,
+                "private_key_pem": _private_key_pem(previous_key),
+                "verify_until": datetime.fromtimestamp(
+                    verify_until, tz=timezone.utc
+                ).isoformat(),
+            }
+        )
+    return json.dumps(
+        {
+            "schema_version": 1,
+            "generation": generation,
+            "token_ttl_minutes": token_ttl_minutes,
+            "current_kid": current_kid,
+            "signing_keys": signing_keys,
+            "accounts": [
+                {
+                    "id": "account-1",
+                    "username": "operator",
+                    "password_hash": PasswordHasher().hash(password),
+                    "role": role,
+                    "enabled": enabled,
+                    "token_version": token_version,
+                }
+            ],
+        }
+    )
 
 
