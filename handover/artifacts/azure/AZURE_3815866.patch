+def _mapping(value: Any, label: str) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise LocalAuthConfigurationError(f"{label} must be an object")
+    return value
+
+
+def _exact_keys(value: dict[str, Any], expected: set[str], label: str) -> None:
+    unexpected = set(value) - expected
+    missing = expected - set(value)
+    if missing or unexpected:
+        raise LocalAuthConfigurationError(
+            f"{label} has missing or unsupported fields"
+        )
+
+
+def _nonempty_string(value: Any, label: str, *, max_length: int = 256) -> str:
+    if not isinstance(value, str) or not value.strip() or len(value) > max_length:
+        raise LocalAuthConfigurationError(f"{label} must be a non-empty string")
+    return value.strip()
