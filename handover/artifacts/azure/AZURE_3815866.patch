diff --git a/infra/scripts/PreDeploy.ps1 b/infra/scripts/PreDeploy.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..4fa4d36a90d72afe55e03b84a161e80d683cd0c3
--- /dev/null
+++ b/infra/scripts/PreDeploy.ps1
@@ -0,0 +1,75 @@
+[CmdletBinding()]
+param()
+
+$ErrorActionPreference = 'Stop'
+
+function Get-AzdValue {
+    param([Parameter(Mandatory)][string]$Name)
+    $value = & azd env get-value $Name 2>$null
+    if ($LASTEXITCODE -ne 0) { return '' }
+    return ($value | Out-String).Trim()
+}
+
+$authMode = (Get-AzdValue 'AZURE_AUTH_MODE').ToLowerInvariant()
+$legacyMode = Get-AzdValue 'AZURE_ENABLE_ENTRA_AUTH'
+if ($legacyMode) {
+    throw 'Deprecated AZURE_ENABLE_ENTRA_AUTH is still present. Remove it and keep the explicit AZURE_AUTH_MODE decision.'
+}
+if ($authMode -notin @('local', 'entra')) {
+    throw 'AZURE_AUTH_MODE must be explicitly set to local or entra before deployment.'
+}
+if ((Get-AzdValue 'AZURE_DEPLOY_CONSUME_DEMO').ToLowerInvariant() -eq 'true' -and $authMode -ne 'entra') {
+    throw 'The consumption demo displays a machine credential and requires AUTH_MODE=entra.'
+}
+
+if ($authMode -eq 'entra') {
+    foreach ($name in @('AZURE_ENTRA_CLIENT_ID', 'AZURE_ENTRA_API_AUDIENCE', 'AZURE_ENTRA_API_SCOPE')) {
+        if (-not (Get-AzdValue $name)) { throw "$name is required for AUTH_MODE=entra." }
+    }
+    $apiAudience = Get-AzdValue 'AZURE_ENTRA_API_AUDIENCE'
+    $apiScope = Get-AzdValue 'AZURE_ENTRA_API_SCOPE'
+    if ($apiAudience -notmatch '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$') {
+        throw 'AZURE_ENTRA_API_AUDIENCE must be the API application client-ID GUID for v2 access tokens.'
+    }
+    $scopePrefix = "api://$apiAudience/"
+    if (-not $apiScope.StartsWith($scopePrefix, [StringComparison]::Ordinal)) {
+        throw "AZURE_ENTRA_API_SCOPE must use $scopePrefix<scope-name>."
+    }
+    $scopeName = $apiScope.Substring($scopePrefix.Length)
+    if ($scopeName -notmatch '^[A-Za-z0-9._-]+$') {
+        throw 'AZURE_ENTRA_API_SCOPE has an invalid scope name.'
+    }
+    $tokenVersion = (& az ad app show --id $apiAudience --query 'api.requestedAccessTokenVersion' --output tsv 2>$null | Out-String).Trim()
+    if ($LASTEXITCODE -ne 0 -or $tokenVersion -ne '2') {
+        throw 'The API app registration must set api.requestedAccessTokenVersion=2 to match the configured v2 issuer.'
+    }
+    $enabledScopes = @(& az ad app show --id $apiAudience --query 'api.oauth2PermissionScopes[?isEnabled].value' --output tsv 2>$null)
+    if ($LASTEXITCODE -ne 0 -or $enabledScopes -notcontains $scopeName) {
+        throw 'AZURE_ENTRA_API_SCOPE is not an enabled delegated scope on the API app registration.'
+    }
+    Write-Host 'Entra authentication deployment inputs are present.'
+    exit 0
+}
+
+if ((Get-AzdValue 'AZURE_API_MIN_REPLICAS') -ne '1' -or (Get-AzdValue 'AZURE_API_MAX_REPLICAS') -ne '1') {
+    throw 'AUTH_MODE=local requires exactly one API replica. Horizontal scale needs a shared transactional login limiter.'
+}
+
+$vaultName = Get-AzdValue 'AZURE_KEY_VAULT_NAME'
+$secretName = Get-AzdValue 'AZURE_LOCAL_AUTH_SECRET_NAME'
+if (-not $vaultName -or -not $secretName) {
+    throw 'AZURE_KEY_VAULT_NAME and AZURE_LOCAL_AUTH_SECRET_NAME are required for AUTH_MODE=local.'
+}
+
+# `list-versions` returns version metadata only. Do not replace it with
+# `secret show`, which retrieves the credential bundle value.
+$enabledVersion = & az keyvault secret list-versions `
+    --vault-name $vaultName `
+    --name $secretName `
+    --query "[?attributes.enabled].id | [-1]" `
+    --output tsv 2>$null
+if ($LASTEXITCODE -ne 0 -or -not ($enabledVersion | Out-String).Trim()) {
+    throw 'No enabled local-auth bundle version exists. Run the separately authorized private-network bootstrap before deployment.'
+}
+
+Write-Host 'Local authentication bundle metadata is present; no secret value was read.'
diff --git a/infra/scripts/manage_local_auth.py b/infra/scripts/manage_local_auth.py
new file mode 100644
index 0000000000000000000000000000000000000000..d93efcfe2adae732d9ad2d0875c5785f264774b2
--- /dev/null
+++ b/infra/scripts/manage_local_auth.py
@@ -0,0 +1,377 @@
+"""Manage the atomic local-auth Key Vault bundle without exposing credential data.
+
+This tool mutates Azure Key Vault and must be run only with explicit authorization
+from a private-network-connected host. Tests import only the pure transformations;
+they never construct an Azure client.
+"""
+from __future__ import annotations
+
+import argparse
+import getpass
+import json
+import secrets
+import sys
+import uuid
+from datetime import datetime, timedelta, timezone
+from typing import Any
+
+from argon2 import PasswordHasher
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric import rsa
+
+from policy_platform.api.local_auth import (
+    AUTH_BUNDLE_SCHEMA_VERSION,
+    MAX_BUNDLE_BYTES,
+    normalize_username,
+    parse_local_auth_bundle,
+)
+from policy_platform.api.roles import ALL_ROLES
+
+_PASSWORD_HASHER = PasswordHasher()
+_MAX_TOKEN_TTL_MINUTES = 480
+MIN_PASSWORD_LENGTH = 15
+
+
+def _now() -> datetime:
+    return datetime.now(tz=timezone.utc)
+
+
+def _new_id() -> str:
+    return str(uuid.uuid4())
+
+
+def _new_private_key_pem() -> str:
+    key = rsa.generate_private_key(public_exponent=65537, key_size=3072)
+    return key.private_bytes(
+        encoding=serialization.Encoding.PEM,
+        format=serialization.PrivateFormat.PKCS8,
+        encryption_algorithm=serialization.NoEncryption(),
+    ).decode("ascii")
+
+
+def _password(prompt: str) -> str:
+    first = getpass.getpass(prompt)
+    second = getpass.getpass("Confirm password: ")
+    if not first or not secrets.compare_digest(first, second):
+        raise ValueError("Password confirmation failed")
+    return validate_password(first)
+
+
+def validate_password(password: str) -> str:
+    """Apply the operator-tool floor before any production hash is written."""
+
+    if len(password) < MIN_PASSWORD_LENGTH:
+        raise ValueError(
+            f"Password must contain at least {MIN_PASSWORD_LENGTH} characters"
+        )
+    return password
+
+
+def _account(document: dict[str, Any], username: str) -> dict[str, Any]:
+    normalized = normalize_username(username)
+    matches = [
+        account
+        for account in document["accounts"]
+        if normalize_username(account["username"]) == normalized
+    ]
+    if len(matches) != 1:
+        raise ValueError("Exactly one matching account is required")
+    return matches[0]
+
+
+def _validated(document: dict[str, Any]) -> dict[str, Any]:
+    raw = json.dumps(document, separators=(",", ":"), sort_keys=True)
+    if len(raw.encode("utf-8")) > MAX_BUNDLE_BYTES:
+        raise ValueError("The local-auth bundle exceeds the Key Vault size limit")
+    parse_local_auth_bundle(
+        raw,
+        max_token_ttl_minutes=_MAX_TOKEN_TTL_MINUTES,
+    )
+    return document
+
+
+def new_bundle(*, admin_username: str, password: str, token_ttl_minutes: int) -> dict[str, Any]:
+    """Create one enabled administrator and a fresh current signing key."""
+
+    password = validate_password(password)
+    document = {
+        "schema_version": AUTH_BUNDLE_SCHEMA_VERSION,
+        "generation": _new_id(),
+        "token_ttl_minutes": token_ttl_minutes,
+        "current_kid": _new_id(),
+        "signing_keys": [],
+        "accounts": [
+            {
+                "id": _new_id(),
+                "username": admin_username,
+                "password_hash": _PASSWORD_HASHER.hash(password),
+                "role": "admin",
+                "enabled": True,
+                "token_version": 1,
+            }
+        ],
+    }
+    document["signing_keys"].append(
+        {
+            "kid": document["current_kid"],
+            "private_key_pem": _new_private_key_pem(),
+            "verify_until": None,
+        }
+    )
+    return _validated(document)
+
+
+def rotate_password(
+    document: dict[str, Any],
+    *,
+    username: str,
+    password: str,
+) -> dict[str, Any]:
+    password = validate_password(password)
+    account = _account(document, username)
+    account["password_hash"] = _PASSWORD_HASHER.hash(password)
+    account["token_version"] += 1
+    return _validated(document)
+
+
+def add_account(
+    document: dict[str, Any],
+    *,
+    username: str,
+    password: str,
+    role: str,
+) -> dict[str, Any]:
+    password = validate_password(password)
+    if role not in ALL_ROLES:
+        raise ValueError("Role is not recognized")
+    normalized = normalize_username(username)
+    if any(
+        normalize_username(account["username"]) == normalized
+        for account in document["accounts"]
+    ):
+        raise ValueError("An account with that normalized username already exists")
+    document["accounts"].append(
+        {
+            "id": _new_id(),
+            "username": username,
+            "password_hash": _PASSWORD_HASHER.hash(password),
+            "role": role,
+            "enabled": True,
+            "token_version": 1,
+        }
+    )
+    return _validated(document)
+
+
+def set_role(
+    document: dict[str, Any],
+    *,
+    username: str,
+    role: str,
+) -> dict[str, Any]:
+    if role not in ALL_ROLES:
+        raise ValueError("Role is not recognized")
+    account = _account(document, username)
+    account["role"] = role
+    account["token_version"] += 1
+    return _validated(document)
+
+
+def disable_account(document: dict[str, Any], *, username: str) -> dict[str, Any]:
+    account = _account(document, username)
+    account["enabled"] = False
+    account["token_version"] += 1
+    return _validated(document)
+
+
+def rotate_signing_key(
+    document: dict[str, Any],
+    *,
+    now: datetime,
+    max_stale_seconds: int,
+) -> dict[str, Any]:
+    current_kid = document["current_kid"]
+    current = next(key for key in document["signing_keys"] if key["kid"] == current_kid)
+    still_required = [
+        key
+        for key in document["signing_keys"]
+        if key["kid"] != current_kid
+        and datetime.fromisoformat(key["verify_until"].replace("Z", "+00:00")) > now
+    ]
+    if still_required:
+        raise ValueError(
+            "A previous signing key is still inside its mandatory verification window"
+        )
+    current["verify_until"] = (
+        now
+        + timedelta(minutes=int(document["token_ttl_minutes"]))
+        + timedelta(seconds=max_stale_seconds)
+    ).isoformat()
+    next_kid = _new_id()
+    document["current_kid"] = next_kid
+    document["signing_keys"] = [
+        {
+            "kid": next_kid,
+            "private_key_pem": _new_private_key_pem(),
+            "verify_until": None,
+        },
+        current,
+    ]
+    return _validated(document)
+
+
+def emergency_revoke(document: dict[str, Any]) -> dict[str, Any]:
+    """Invalidate every local token and replace the whole verification ring."""
+
+    document["generation"] = _new_id()
+    next_kid = _new_id()
+    document["current_kid"] = next_kid
+    document["signing_keys"] = [
+        {
+            "kid": next_kid,
+            "private_key_pem": _new_private_key_pem(),
+            "verify_until": None,
+        }
+    ]
+    return _validated(document)
+
+
+def rollback_as_new_generation(previous: dict[str, Any]) -> dict[str, Any]:
+    """Republish prior account state without reviving any prior bearer token."""
+
+    return emergency_revoke(previous)
+
+
+def _load_document(client: Any, secret_name: str, version: str | None = None) -> dict[str, Any]:
+    secret = client.get_secret(secret_name, version=version)
+    if not secret.value:
+        raise ValueError("The selected local-auth bundle is empty")
+    document = json.loads(secret.value)
+    _validated(document)
+    return document
+
+
+def _write_document(client: Any, secret_name: str, document: dict[str, Any]) -> None:
+    value = json.dumps(_validated(document), separators=(",", ":"), sort_keys=True)
+    client.set_secret(secret_name, value, content_type="application/json")
+
+
+def _client(vault_url: str):
+    from azure.identity import AzureCliCredential
+    from azure.keyvault.secrets import SecretClient
+
+    credential = AzureCliCredential()
+    return credential, SecretClient(vault_url=vault_url, credential=credential)
+
+
+def _secret_exists(client: Any, secret_name: str) -> bool:
+    try:
+        return any(version.enabled for version in client.list_properties_of_secret_versions(secret_name))
+    except Exception as exc:
+        from azure.core.exceptions import ResourceNotFoundError
+
+        if isinstance(exc, ResourceNotFoundError):
+            return False
+        raise
+
+
+def _parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Manage the PolicyVerbAItim local-auth Key Vault bundle."
+    )
+    parser.add_argument("--vault-url", required=True)
+    parser.add_argument("--secret-name", default="policy-local-auth")
+    parser.add_argument(
+        "--max-stale-seconds",
+        type=int,
+        default=300,
+        help="Must match AZURE_LOCAL_AUTH_MAX_STALE_SECONDS for safe key overlap.",
+    )
+    subcommands = parser.add_subparsers(dest="command", required=True)
+
+    bootstrap = subcommands.add_parser("bootstrap")
+    bootstrap.add_argument("--token-ttl-minutes", type=int, default=60)
+
+    subcommands.add_parser("rotate-password")
+    add = subcommands.add_parser("add-account")
+    add.add_argument("--role", choices=ALL_ROLES, required=True)
+    role = subcommands.add_parser("set-role")
+    role.add_argument("--role", choices=ALL_ROLES, required=True)
+    subcommands.add_parser("disable-account")
+    subcommands.add_parser("rotate-signing-key")
+    subcommands.add_parser("emergency-revoke")
+    rollback = subcommands.add_parser("rollback")
+    rollback.add_argument("--version", required=True)
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = _parser().parse_args(argv)
+    credential, client = _client(args.vault_url)
+    try:
+        if args.command == "bootstrap":
+            if _secret_exists(client, args.secret_name):
+                raise ValueError("Bootstrap refuses to overwrite an existing enabled bundle")
+            username = input("Administrator username: ").strip()
+            document = new_bundle(
+                admin_username=username,
+                password=_password("Administrator password: "),
+                token_ttl_minutes=args.token_ttl_minutes,
+            )
+        elif args.command == "rollback":
+            document = rollback_as_new_generation(
+                _load_document(client, args.secret_name, version=args.version)
+            )
+        else:
+            document = _load_document(client, args.secret_name)
+            if args.command == "rotate-password":
+                document = rotate_password(
+                    document,
+                    username=input("Account username: ").strip(),
+                    password=_password("New password: "),
+                )
+            elif args.command == "add-account":
+                document = add_account(
+                    document,
+                    username=input("New account username: ").strip(),
+                    password=_password("New account password: "),
+                    role=args.role,
+                )
+            elif args.command == "set-role":
+                document = set_role(
+                    document,
+                    username=input("Account username: ").strip(),
+                    role=args.role,
+                )
+            elif args.command == "disable-account":
+                document = disable_account(
+                    document,
+                    username=input("Account username: ").strip(),
+                )
+            elif args.command == "rotate-signing-key":
+                document = rotate_signing_key(
+                    document,
+                    now=_now(),
+                    max_stale_seconds=args.max_stale_seconds,
+                )
+            elif args.command == "emergency-revoke":
+                confirmation = input("Type EMERGENCY-REVOKE to invalidate every local token: ")
+                if confirmation != "EMERGENCY-REVOKE":
+                    raise ValueError("Emergency revocation was not confirmed")
+                document = emergency_revoke(document)
+            else:
+                raise ValueError("Unsupported operation")
+
+        _write_document(client, args.secret_name, document)
+        print("Local-auth bundle operation completed; no credential data was displayed.")
+        return 0
+    except (ValueError, json.JSONDecodeError) as exc:
+        print(f"Local-auth bundle operation refused: {exc}", file=sys.stderr)
+        return 2
+    finally:
+        client.close()
+        credential.close()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
