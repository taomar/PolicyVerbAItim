+        role = _nonempty_string(entry["role"], "role", max_length=64)
+        if role not in ALL_ROLES:
+            raise LocalAuthConfigurationError("Account role is not recognized")
+        enabled = entry["enabled"]
+        if not isinstance(enabled, bool):
+            raise LocalAuthConfigurationError("Account enabled must be boolean")
+        token_version = _positive_int(entry["token_version"], "token_version")
+        password_hash = _nonempty_string(
+            entry["password_hash"], "password_hash", max_length=1_024
+        )
